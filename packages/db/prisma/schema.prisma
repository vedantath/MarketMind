generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum RecordSource {
  MANUAL
  IMPORTED
}

enum TransactionType {
  BUY
  SELL
  DIVIDEND
  SPLIT
  TRANSFER_IN
  TRANSFER_OUT
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
}

enum AlertType {
  PRICE
  SENTIMENT
  NEWS
}

enum AlertCondition {
  PRICE_ABOVE
  PRICE_BELOW
  PERCENT_CHANGE_UP
  PERCENT_CHANGE_DOWN
}

// ── Models ─────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // nullable: OAuth users have no password; passwordHash is MarketMind-native auth only
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  portfolios Portfolio[]
  alerts     Alert[]
}

model Portfolio {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings     Holding[]
  transactions Transaction[]
}

model Holding {
  id          String       @id @default(cuid())
  portfolioId String
  symbol      String
  quantity    Decimal      @db.Decimal(20, 8)
  costBasis   Decimal      @db.Decimal(20, 8)
  source      RecordSource @default(MANUAL)
  externalId  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  portfolio    Portfolio     @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([portfolioId, symbol])
}

model Transaction {
  id          String          @id @default(cuid())
  portfolioId String
  holdingId   String?
  symbol      String
  type        TransactionType
  quantity    Decimal         @db.Decimal(20, 8)
  price       Decimal         @db.Decimal(20, 8)
  fees        Decimal?        @db.Decimal(20, 8)
  executedAt  DateTime
  source      RecordSource    @default(MANUAL)
  externalId  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  holding   Holding?  @relation(fields: [holdingId], references: [id])
}

// condition and threshold are type-discriminated: PRICE alerts require both,
// SENTIMENT alerts may use threshold, NEWS alerts use neither.
// The per-type required-field invariant is enforced in the alert service, not the DB.
model Alert {
  id          String         @id @default(cuid())
  userId      String
  symbol      String
  type        AlertType
  severity    AlertSeverity  @default(LOW)
  condition   AlertCondition?
  threshold   Decimal?       @db.Decimal(20, 8)
  triggered   Boolean        @default(false)
  triggeredAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
