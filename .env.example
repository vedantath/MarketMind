# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketmind

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Vector DB (Qdrant) ────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# ── News data ─────────────────────────────────────────────────────────────────
NEWSAPI_KEY=
GDELT_ENABLED=true

# ── Market data ───────────────────────────────────────────────────────────────
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
POLYGON_API_KEY=

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
WEB_PORT=3000
GATEWAY_PORT=3001
PORTFOLIO_PORT=4001
WEB_ORIGIN=http://localhost:3000
PORTFOLIO_SERVICE_URL=http://127.0.0.1:4001
# Shared secret between api-gateway and services/portfolio — generate a real random value per
# environment, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
INTERNAL_SERVICE_SECRET=change_me_generate_a_random_secret
